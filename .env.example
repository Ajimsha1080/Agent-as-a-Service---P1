# Hospitality Agent Cloud - Environment Configuration
PROJECT_NAME="Hospitality Agent Cloud"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="development_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=115200

# Database & Storage
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/hospitality_agent_cloud"
PGVECTOR_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/hospitality_agent_cloud"
REDIS_URL="redis://localhost:6379/0"

# AI Models & Providers (LiteLLM Compatible)
OPENAI_API_KEY="sk-mock-openai-key-for-dev"
ANTHROPIC_API_KEY="sk-mock-anthropic-key-for-dev"
GOOGLE_API_KEY="mock-google-key-for-dev"

# Voice STT / TTS Providers
STT_PROVIDER="whisper_mock"
TTS_PROVIDER="elevenlabs_mock"
ELEVENLABS_API_KEY="mock-elevenlabs-key"

# Channels & Integrations
WHATSAPP_API_KEY="mock-whatsapp-key"
WHATSAPP_PHONE_NUMBER_ID="mock-phone-id"
PAYMENT_PROVIDER_KEY="mock-stripe-key"
STORAGE_PROVIDER="local"

# Observability
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY="mock-langsmith-key"
